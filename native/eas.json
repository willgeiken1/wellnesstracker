{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "free-iphone": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "local",
      "env": {
        "APP_VARIANT": "freeiphone",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "buildConfiguration": "Debug"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  }
}
