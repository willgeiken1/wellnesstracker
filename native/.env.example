# Local SQLite works without auth. For auth/sync testing prefer a local loopback DB.
# Only loopback or the hosted Insight project are accepted; publishable key only. Will sets values himself.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Crash reports and usage analytics stay off until these are set (and the user's switch is on).
# Sentry DSN and PostHog project key for the native app (US region). Both are public client keys.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
