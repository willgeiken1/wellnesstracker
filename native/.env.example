# Local SQLite works without auth. For auth/sync testing use a local loopback DB only.
# Never use a hosted project; publishable key only. Will sets values himself.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Crash reports and usage analytics stay off until these are set (and the user's switch is on).
# Sentry DSN and PostHog project key for the native app (US region). Both are public client keys.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
